{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "public": true,
  "functions": {
    "api/index.py": {
      "maxDuration": 60,
      "includeFiles": "backend/seed_embeddings.json"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.py"
    }
  ]
}
