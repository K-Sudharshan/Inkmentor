# InkMentor Backend Configuration
LLM_PROVIDER=gemini
LLM_API_KEY=your_gemini_api_key_here
LLM_MODEL=gemini-2.5-flash

# TTS Voice Configuration
# Provider: 'gnani' (Indian Voice AI), 'gemini' (warm natural voice), or 'groq' (ultra-fast <200ms)
TTS_PROVIDER=gnani
TTS_PROVIDER_ORDER=gnani,gemini,groq
# Gnani.ai API Configuration (The Great Indian AI Internship Challenge)
GNANI_API_KEY=
GNANI_TTS_MODEL=timbre-v3.0
GNANI_TTS_VOICE=Nalini
GNANI_TTS_LANG=en-IN
GNANI_STT_MODEL=prisma-v3.0
# Optional dedicated Gemini key for TTS (avoids consuming solver/vision quota):
TTS_API_KEY=
# Optional Groq key for ultra-low latency voice:
GROQ_API_KEY=
LLM_TTS_MODEL=gemini-3.8-flash-lite-tts
# TTS Voice (for Groq Orpheus: autumn, diana, hannah, austin, daniel, troy; for Gemini: Puck, Charon, Kore, Fenrir, Aoede)
TTS_VOICE=autumn
# Vocal directions for Groq Orpheus (1-2 lowercase words, e.g. cheerful, playfully, warmly, dramatically):
# Middle step direction (default):
TTS_DIRECTION=playfully
# Optional override for the first step (falls back to TTS_DIRECTION if unset):
TTS_DIRECTION_FIRST=cheerful
# Optional override for the last step (falls back to TTS_DIRECTION if unset):
TTS_DIRECTION_LAST=warmly
TTS_RATE_PER_MIN=40
TTS_TIMEOUT_SECONDS=4
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:5500

# Google OAuth Authentication
# Google Cloud OAuth 2.0 Web Client ID (e.g., 123456789-abc.apps.googleusercontent.com)
GOOGLE_CLIENT_ID=

